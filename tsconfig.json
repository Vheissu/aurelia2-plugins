{
    "compilerOptions": {
      "incremental": true,
      "target": "es2022",
      "module": "esnext",
      // TypeScript 6 defaults `strict` to true; these packages were authored
      // against the previous non-strict default, so keep it explicit.
      "strict": false,
      "noImplicitAny": false,
      "isolatedModules": true,
      "lib": ["esnext", "DOM"],
      "moduleResolution": "bundler",
      "resolveJsonModule": true,
      "declaration": true,
      "declarationMap": true,
      "sourceMap": true,
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "skipLibCheck": true,
      "preserveConstEnums": true
    },
    "files": [
        "./types/global.d.ts"
    ]
  }
