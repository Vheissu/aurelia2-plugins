{
  "name": "@vheissu/aurelia2-plugins",
  "version": "1.0.1",
  "description": "A collection of Aurelia 2 plugins",
  "repository": "https://github.com/Vheissu/aurelia2-plugins",
  "author": "Dwayne Charrington <dwaynecharrington@gmail.com",
  "license": "MIT",
  "scripts": {
    "build": "npm run build --workspaces",
    "lint": "eslint packages/*/src/**/*.ts",
    "test": "cross-env JEST_PROJECTS=1 jest --config ./jest.projects.cjs --passWithNoTests",
    "release": "node scripts/release.mjs",
    "release:dry-run": "node scripts/release.mjs --dry-run"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@aurelia/ts-jest": "^2.0.0-rc.2",
    "@aurelia/testing": "^2.0.0-rc.2",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "aurelia": "^2.0.0-rc.2",
    "cpx2": "^9.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "jest": "^30.4.2",
    "jest-cli": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-transform-stub": "^2.0.0",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
