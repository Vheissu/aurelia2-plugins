{
  "name": "@vheissu/aurelia2-plugins",
  "version": "1.0.1",
  "description": "A collection of Aurelia 2 plugins",
  "repository": "https://github.com/Vheissu/aurelia2-plugins",
  "author": "Dwayne Charrington <dwaynecharrington@gmail.com",
  "license": "MIT",
  "scripts": {
    "build": "npm run build --workspaces",
    "lint": "eslint packages/*/src/**/*.ts",
    "test": "cross-env JEST_PROJECTS=1 jest --config ./jest.projects.cjs --passWithNoTests",
    "release": "node scripts/release.mjs",
    "release:dry-run": "node scripts/release.mjs --dry-run"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@aurelia/testing": "^2.0.0-rc.2",
    "@aurelia/ts-jest": "^2.0.0-rc.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "aurelia": "^2.0.0-rc.2",
    "cpx2": "^9.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^64.5.4",
    "jest": "^30.5.2",
    "jest-cli": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-transform-stub": "^2.0.0",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
