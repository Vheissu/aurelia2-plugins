{
  "name": "aurelia2-auth",
  "version": "1.2.0",
  "description": "Authentication, OAuth/OIDC and policy-based authorization for Aurelia 2",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": "https://github.com/Vheissu/aurelia2-plugins",
  "author": "Dwayne Charrington <dwaynecharrington@gmail.com>",
  "license": "MIT",
  "scripts": {
    "clean": "rimraf ./dist",
    "prebuild": "npm run clean",
    "build:ts": "tsc",
    "build:other": "cpx \"./src/**/*.{html,css}\" ./dist",
    "build": "npm run build:ts && npm run build:other",
    "watch:ts": "tsc --watch --preserveWatchOutput",
    "watch:other": "cpx \"./src/**/*.{html,css}\" ./dist --watch",
    "test:debug": "cross-env DEBUG=true npm run test",
    "test:watch": "cross-env DEV=true npm run test",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --runInBand"
  },
  "devDependencies": {
    "@aurelia/router": "^2.0.0-rc.2",
    "aurelia": "^2.0.0-rc.2"
  },
  "peerDependencies": {
    "@aurelia/router": ">=2.0.0-rc.2",
    "aurelia": ">=2.0.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@aurelia/router": {
      "optional": true
    }
  }
}
